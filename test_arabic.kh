نافذة("FPS Camera", 1280, 720)

# إعداد أولي للكاميرا
الكاميرا.الموقع = متجه3(0, 2, 5)
الكاميرا.الدوران = متجه3(0, 0, 0)
الكاميرا.صدام = مفعل

# سماء Cubemap (ترتيب: يمين، يسار، أعلى، أسفل، أمام، خلف)
سماء_احترافية = صنع_سماء_cubemap(
    "px.png",
    "nx.png",
    "py.png",
    "ny.png",
    "pz.png",
    "nz.png"
)

# إعدادات الحركة
سرعة_الحركة = 8.0
حساسية_الماوس = 0.15
ارتفاع_الكاميرا = 2.0

# أرضية
الأرض = صنع_سطح()
الأرض.الموقع = متجه3(0, 0, 0)
الأرض.المقياس = متجه3(50, 1, 50)
الأرض.اللون = لون(0.35, 0.55, 0.3)
الأرض.صدام = مفعل

# المكعب الأول
مكعب1 = صنع_مكعب()
مكعب1.الموقع = متجه3(0, 1, -5)
مكعب1.اللون = لون(0.9, 0.2, 0.2)
مكعب1.صدام = مفعل
مكعب1.جاذبية = 1

# المكعب الثاني
مكعب2 = صنع_مكعب()
مكعب2.الموقع = متجه3(4, 1, -8)
مكعب2.اللون = لون(0.2, 0.4, 0.9)

# السيارة
ابغا سيارة = صنع_fbx("car.fbx")
سيارة.الموقع = متجه3(0.3, 10, 0)
سيارة.المقياس = متجه3(0.5, 0.5, 0.5)
سيارة.صدام = مفعل
سيارة.جاذبية = مفعل
سيارة.الدوران = متجه3(90, 90, 90)
سيارة.الخامة = "tex.png"
اطبع نوع(سيارة.المكون)

# متغيرات القفز للسيارة
سرعة_قفز_سيارة = 8.0
السيارة_على_الأرض = مقفل
حساسية_سيارة = 5.0

كل_فريم:
    # ─── حركة الماوس للكاميرا ───
    الكاميرا.الدوران.y += ماوس.حركة_أفقية * حساسية_الماوس
    الكاميرا.الدوران.x -= ماوس.حركة_عمودية * حساسية_الماوس

    اذا الكاميرا.الدوران.x > 89:
        الكاميرا.الدوران.x = 89
    اذا الكاميرا.الدوران.x < -89:
        الكاميرا.الدوران.x = -89

    # تأثير التقريب (Zoom)
    اذا كيبورد.z == مفعل:
        الكاميرا.زاوية_الرؤية = 20.0
    غير_ذلك:
        الكاميرا.زاوية_الرؤية = 70.0

    # ─── حركة الكاميرا الأفقية ───
    السرعة = سرعة_الحركة * وقت.دلتا()
    أمام_أفقي = متجه3(الكاميرا.الأمام.x, 0, الكاميرا.الأمام.z)
    يمين_أفقي = متجه3(الكاميرا.اليمين.x, 0, الكاميرا.اليمين.z)

    اذا كيبورد.w == مفعل:
        الكاميرا.الموقع += أمام_أفقي * السرعة
    اذا كيبورد.s == مفعل:
        الكاميرا.الموقع -= أمام_أفقي * السرعة
    اذا كيبورد.a == مفعل:
        الكاميرا.الموقع -= يمين_أفقي * السرعة
    اذا كيبورد.d == مفعل:
        الكاميرا.الموقع += يمين_أفقي * السرعة

    # تثبيت ارتفاع الكاميرا
    الكاميرا.الموقع.y = ارتفاع_الكاميرا

    # ─── حركة السيارة بالأسهم ───
    سرعة_سيارة = حساسية_سيارة * وقت.دلتا()
    اذا كيبورد.يسار == مفعل:
        سيارة.الموقع.x -= سرعة_سيارة
    اذا كيبورد.يمين == مفعل:
        سيارة.الموقع.x += سرعة_سيارة
    اذا كيبورد.أعلى == مفعل:
        سيارة.الموقع.z -= سرعة_سيارة
    اذا كيبورد.أسفل == مفعل:
        سيارة.الموقع.z += سرعة_سيارة

    # ─── القفز للسيارة (مفتاح المسافة) ───
    اذا سيارة.الموقع.y < 2.0:
        السيارة_على_الأرض = مفعل
    غير_ذلك:
        السيارة_على_الأرض = مقفل

    اذا كيبورد.مسافة == مفعل و السيارة_على_الأرض == مفعل:
        سيارة._velocity.y = سرعة_قفز_سيارة
