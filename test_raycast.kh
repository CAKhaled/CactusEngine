نافذة("Raycast Test", 800, 600)

الهدف1 = صنع_مكعب()
الهدف1.الموقع = متجه3(0, 0, 5)
الهدف1.الاسم = "مكعب أخضر"
الهدف1.اللون = لون(0, 1, 0)

الهدف2 = صنع_مكعب()
الهدف2.الموقع = متجه3(0, 0, 10)
الهدف2.الاسم = "مكعب أحمر"
الهدف2.اللون = لون(1, 0, 0)

الوقت = 0
السرعة = 5.0

كل_فريم:
    الوقت += وقت.دلتا()
    
    # حركة الكاميرا
    اذا كيبورد.w == مفعل:
        الكاميرا.الموقع += الكاميرا.الأمام * السرعة * وقت.دلتا()
    اذا كيبورد.s == مفعل:
        الكاميرا.الموقع -= الكاميرا.الأمام * السرعة * وقت.دلتا()
    اذا كيبورد.a == مفعل:
        الكاميرا.الموقع -= الكاميرا.اليمين * السرعة * وقت.دلتا()
    اذا كيبورد.d == مفعل:
        الكاميرا.الموقع += الكاميرا.اليمين * السرعة * وقت.دلتا()

    الكاميرا.الدوران.y += ماوس.حركة_أفقية * 0.1
    الكاميرا.الدوران.x -= ماوس.حركة_عمودية * 0.1

    الشيء = الكاميرا.اشعاع(20)
    اذا الشيء != فارغ:
        اطبع "أنظر إلى: " + الشيء.الاسم
    غير_ذلك:
        اطبع "لا شيء"
