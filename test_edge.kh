كلاس الخلية:
    الاسم = ""
    دالة بناء(الاسم):
        هذا.الاسم = الاسم
    دالة ضف():
        اطبع "تم استدعاء ضف من الكائن"

ابغا مصفوفة = []
ابغا خ = الخلية("تيست")

# هل اقدر اضيف الكائن؟
مصفوفة.ضف(خ)
اطبع مصفوفة[0].الاسم

# هل اقدر استدعي ضف للكائن الي داخل المصفوفة؟
مصفوفة[0].ضف()

# هل اقدر احذف الكائن؟
مصفوفة.احذف(خ)
اطبع "الطول بعد الحذف: "
اطبع مصفوفة
