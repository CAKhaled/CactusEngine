# تجربة تحميل موديل سيارة (FBX) والتحكم بمكوناتها بشكل مستقل

# إعداد النافذة
نافذة("تجربة السيارة", 1280, 720)

# إعداد الكاميرا
الكاميرا.الموقع = متجه3(0, 5, -15)
الكاميرا.الدوران = متجه3(20, 0, 0)

# إضافة سطح (أرضية) لنجلس عليه المجسم
ابغا الأرضية = صنع_سطح()
الأرضية.الموقع = متجه3(0, -1, 0)
الأرضية.المقياس = متجه3(50, 1, 50)
الأرضية.اللون = لون(0.3, 0.55, 0.3)

# إضاءة عشان نشوف الألوان كويس
ابغا ضوء = صنع_ضوء()
ضوء.النوع = "ضوء_موجه"
ضوء.الموقع = متجه3(10, 20, 10)
ضوء.اللون = لون(1.0, 1.0, 1.0)

# تحميل موديل السيارة الأساسي
ابغا سيارة = صنع_fbx("car.fbx")
سيارة.الموقع = متجه3(0, 0, 0)
اطبع سيارة.المكون 

# إضافة واجهة بسيطة
ابغا واجهة = صنع_واجهة()
ابغا نص = واجهة.اضافة_نص("تجربة استخراج المكونات تعمل بنجاح!")
نص.الموقع = متجه2(50, 50)
نص.اللون = لون(0, 1, 0)

# تحريك المجسم الأساسي
كل_فريم:
    سيارة.الموقع.z += وقت.دلتا() * 10
