كلاس سيارة:
    دالة بناء(اللون, السرعة):
        هذا.اللون = اللون
        هذا.السرعة = السرعة
        
    دالة تحرك():
        اطبع "السيارة ذات اللون " + هذا.اللون + " تتحرك بسرعة " + هذا.السرعة

    دالة زيادة_السرعة(المقدار):
        هذا.السرعة += المقدار
        اطبع "تمت زيادة السرعة! السرعة الحالية: " + هذا.السرعة

# إنشاء كائن من الكلاس سيارة
ابغا سيارتي = سيارة("الأحمر", 100)

اطبع "--- بيانات السيارة ---"
اطبع "لون السيارة:"
اطبع سيارتي.اللون

اطبع "سرعة السيارة:"
اطبع سيارتي.السرعة

اطبع "--- تجربة الدوال ---"
سيارتي.تحرك()
سيارتي.زيادة_السرعة(20)
سيارتي.تحرك()

اطبع "--- إنشاء سيارة أخرى ---"
ابغا سيارة_صديقي = سيارة("الأسود", 80)
سيارة_صديقي.تحرك()

اطبع "--- تجربة المصفوفات مع الكائنات ---"
ابغا سيارات = [سيارتي, سيارة_صديقي, سيارة("الأبيض", 120)]
اطبع سيارات[0].اللون
سيارات[1].زيادة_السرعة(10)
سيارات[2].تحرك()
