# 1. تهيئة نافذة اللعبة
نافذة("Flappy Bird - KH", 800, 600)

# 2. إنشاء خلفية الشاشة واللاعب (الطير)
صنع_سماء(لون(0.5, 0.8, 1.0)) # خلفية زرقاء سماوية

الطير = صنع_مخصص2D("bird.png")
الطير.الموقع = متجه2(150, 300)
الطير.المقياس = متجه2(40, 40)
اللون_الاصلي_لطير = لون(1.0, 1.0, 1.0) # حفظ لون الطير الأصلي

# 3. إنشاء الأنابيب
أنبوب_علوي = صنع_مخصص2D("wall.png")
أنبوب_علوي.الموقع = متجه2(800, -150)
أنبوب_علوي.المقياس = متجه2(80, 400)
أنبوب_علوي.الدوران = 180

أنبوب_سفلي = صنع_مخصص2D("wall.png")
أنبوب_سفلي.الموقع = متجه2(800, 400)
أنبوب_سفلي.المقياس = متجه2(80, 400)
أنبوب_سفلي.الدوران = 0

# 4. متغيرات الحركة والفيزياء
الجاذبية = 0.4
سرعة_القفز = -4.0
السرعة_الحالية = 0.0
سرعة_الأنابيب = 4.0
هل_اللاعب_حي = مفعل

# 5. حلقة التحديث الرئيسية (Game Loop)
كل_فريم:
    اذا هل_اللاعب_حي == مفعل:
        # حركة الجاذبية للطير
        السرعة_الحالية += الجاذبية
        الطير.الموقع.y += السرعة_الحالية

        # القفز عند الضغط على زر المسافة أو زر الماوس الأيسر
        اذا كيبورد.مسافة == مفعل او ماوس.ضغط_يسار == مفعل:
            السرعة_الحالية = سرعة_القفز

        # تحريك الأنابيب باتجاه اليسار
        أنبوب_علوي.الموقع.x -= سرعة_الأنابيب
        أنبوب_سفلي.الموقع.x -= سرعة_الأنابيب

        # إعادة الأنابيب إلى اليمين بـ ارتفاع عشوائي ومناسب
        اذا أنبوب_علوي.الموقع.x < -80:
            أنبوب_علوي.الموقع.x = 850
            أنبوب_سفلي.الموقع.x = 850
            
            إزاحة_عشوائية = عشوائي(-100.0, 100.0)
            أنبوب_علوي.الموقع.y = -150 + إزاحة_عشوائية
            أنبوب_سفلي.الموقع.y = 400 + إزاحة_عشوائية

        # التحقق من اصطدام الطير بالأنابيب أو بسقف/أرضية الشاشة
        اذا الطير.تصادم == مفعل او الطير.الموقع.y > 580 او الطير.الموقع.y < 0:
            هل_اللاعب_حي = مقفل
            الطير.اللون = لون(1.0, 0.0, 0.0) # تغيير لون الطير إلى الأحمر عند الخسارة

    غير_ذلك:
        # في حالة الخسارة: عند الضغط على زر انتر أو المسافة يتم إعادة بدء اللعبة
        اذا كيبورد.انتر == مفعل او كيبورد.مسافة == مفعل:
            # إعادة تصفير موقع الطير وسرعته ولونه
            الطير.الموقع = متجه2(150, 300)
            السرعة_الحالية = 0.0
            الطير.اللون = اللون_الاصلي_لطير

            # إعادة الأنابيب لمواقعها الأولية
            أنبوب_علوي.الموقع = متجه2(800, -150)
            أنبوب_سفلي.الموقع = متجه2(800, 400)

            # إعادة تفعيل اللعبة
            هل_اللاعب_حي = مفعل