# تجربة المصفوفات في لغة KH

الأرقام = [10, 20, 30]

اطبع "قيمة المصفوفة الأولى (المؤشر 0):"
اطبع الأرقام[0]

# تغيير القيمة في المؤشر 1
الأرقام[1] = 50

اطبع "قيمة المصفوفة الثانية بعد التغيير (المؤشر 1):"
اطبع الأرقام[1]

# إجراء عملية حسابية 
النتيجة = الأرقام[0] + الأرقام[2]
اطبع "مجموع الرقم الأول والثالث هو:"
اطبع النتيجة
