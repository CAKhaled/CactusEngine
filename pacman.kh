# لعبة باك مان مخصصة ومحسنة الأداء
واجهتي = صنع_واجهة()
نص_البداية = واجهتي.اضافة_نص("اجمع النقاط وتجنب الأعداء!")
نص_البداية.عمودي = "فوق"
نص_البداية.افقي = "وسط"
نص_البداية.حجم_الخط = 30
نص_البداية.اللون = لون(1.0, 1.0, 1.0)
نص_البداية.ازاحة = متجه2(120, 10)

اللاعب = صنع_مخصص2D("pacman.jpg")
اللاعب.الموقع = متجه2(75, 75)
اللاعب.المقياس = متجه2(44, 44)

حجم_المربع = 50
الجدران = []
الطعام = []
عدد_الطعام = 0

خريطة = [
"11111111111111111111",
"10000000000000000001",
"10111011111111011101",
"10100000011000000101",
"10101111011011110101",
"10001000000000010001",
"11101011100111010111",
"10000010000001000001",
"11101011111111010111",
"10001000011000010001",
"10101111011011110101",
"10100000011000000101",
"10111011111111011101",
"10000000000000000001",
"11111111111111111111"
]

صف = 0
كرر:
    عمود = 0
    كرر:
        حرف = خريطة[صف][عمود]
        س = عمود * حجم_المربع + (حجم_المربع / 2)
        ص = صف * حجم_المربع + (حجم_المربع / 2)
        اذا حرف == "1":
            جدار = صنع_مربع2D()
            جدار.الموقع = متجه2(س, ص)
            جدار.المقياس = متجه2(حجم_المربع, حجم_المربع)
            جدار.اللون = لون(0.1, 0.1, 0.8)
            الجدران.ضف(جدار)
        اذا حرف == "0":
            # استخدام نصوص واجهة للطعام لتقليل حسابات التصادم
            طعام = واجهتي.اضافة_نص("o")
            طعام.عمودي = "فوق"
            طعام.افقي = "يسار"
            طعام.ازاحة = متجه2(س - 10, ص - 25)
            طعام.اللون = لون(1.0, 0.8, 0.0)
            طعام.حجم_الخط = 38
            الطعام.ضف(طعام)
            عدد_الطعام += 1
            
        عمود += 1
        اذا عمود == 20:
            توقف
    صف += 1
    اذا صف == 15:
        توقف

الأعداء = []
اتجاهات_الأعداء = []
عدد_الأعداء = 4

نص_الخسارة = واجهتي.اضافة_نص("")
نص_الخسارة.عمودي = "وسط"
نص_الخسارة.افقي = "وسط"
نص_الخسارة.حجم_الخط = 50
نص_الخسارة.اللون = لون(1.0, 0.0, 0.0)
نص_الخسارة.ازاحة = متجه2(120, 0)

مؤشر_انشاء_عدو = 0
كرر:
    اذا مؤشر_انشاء_عدو >= عدد_الأعداء:
        توقف
    عدو = صنع_مربع2D()
    عدو.الموقع = متجه2(475, 325)
    عدو.المقياس = متجه2(35, 35)
    اذا مؤشر_انشاء_عدو == 0:
        عدو.اللون = لون(1.0, 0.0, 0.0)
    اذا مؤشر_انشاء_عدو == 1:
        عدو.اللون = لون(1.0, 0.5, 0.5)
    اذا مؤشر_انشاء_عدو == 2:
        عدو.اللون = لون(0.0, 1.0, 1.0)
    اذا مؤشر_انشاء_عدو == 3:
        عدو.اللون = لون(1.0, 0.5, 0.0)
        
    الأعداء.ضف(عدو)
    اتجاهات_الأعداء.ضف(متجه2(1, 0))
    مؤشر_انشاء_عدو += 1

السرعة = 4.4
سرعة_العدو = 3.1
اتجاه_اللاعب = متجه2(0, 0)
هل_اللاعب_حي = مفعل

مؤشر_طعام_حالي = 0

كل_فريم:
    اذا هل_اللاعب_حي == مفعل:
        # حركة وتصادم اللاعب بالاعتماد على محرك التصادم الداخلي
        اذا اللاعب.تصادم == مفعل:
            # ارتداد عند الاصطدام بجدار أو عدو
            اللاعب.الموقع.x -= اتجاه_اللاعب.x * السرعة * 1.5
            اللاعب.الموقع.y -= اتجاه_اللاعب.y * السرعة * 1.5
            اتجاه_اللاعب = متجه2(0, 0)
        غير_ذلك:
            # قراءة المدخلات إذا لم يكن هناك تصادم
            اذا كيبورد.w == مفعل او كيبورد.أعلى == مفعل:
                اتجاه_اللاعب = متجه2(0, -1)
                اللاعب.الدوران = متجه3(0, 0, 90)
            اذا كيبورد.s == مفعل او كيبورد.أسفل == مفعل:
                اتجاه_اللاعب = متجه2(0, 1)
                اللاعب.الدوران = متجه3(0, 0, 270)
            اذا كيبورد.a == مفعل او كيبورد.يسار == مفعل:
                اتجاه_اللاعب = متجه2(-1, 0)
                اللاعب.الدوران = متجه3(0, 0, 180)
            اذا كيبورد.d == مفعل او كيبورد.يمين == مفعل:
                اتجاه_اللاعب = متجه2(1, 0)
                اللاعب.الدوران = متجه3(0, 0, 0)
                
            اللاعب.الموقع.x += اتجاه_اللاعب.x * السرعة
            اللاعب.الموقع.y += اتجاه_اللاعب.y * السرعة
            
        # التحقق من أكل الطعام بطريقة سريعة جدا (نقسم الفحص على عدة فريمات)
        عداد_فحص = 0
        كرر:
            اذا عداد_فحص >= 15:
                توقف
            اذا مؤشر_طعام_حالي >= عدد_الطعام:
                مؤشر_طعام_حالي = 0
                توقف
                
            طعام = الطعام[مؤشر_طعام_حالي]
            فرق_س = اللاعب.الموقع.x - (طعام.ازاحة.x + 10)
            اذا فرق_س < 0:
                فرق_س = 0 - فرق_س
            اذا فرق_س < 31:
                فرق_ص = اللاعب.الموقع.y - (طعام.ازاحة.y + 25)
                اذا فرق_ص < 0:
                    فرق_ص = 0 - فرق_ص
                اذا فرق_ص < 31:
                    طعام.ازاحة.x = -1000
                    طعام.ازاحة.y = -1000
            
            مؤشر_طعام_حالي += 1
            عداد_فحص += 1
            
        # تحديث الأعداء
        مؤشر_تحديث_عدو = 0
        كرر:
            اذا مؤشر_تحديث_عدو >= عدد_الأعداء:
                توقف
            
            عدو = الأعداء[مؤشر_تحديث_عدو]
            اتجاه = اتجاهات_الأعداء[مؤشر_تحديث_عدو]
            
            اذا عدو.تصادم == مفعل:
                عدو.الموقع.x -= اتجاه.x * سرعة_العدو * 1.5
                عدو.الموقع.y -= اتجاه.y * سرعة_العدو * 1.5
                
                رقم_عشوائي = عشوائي(0.0, 4.0)
                اذا رقم_عشوائي < 1.0:
                    اتجاهات_الأعداء[مؤشر_تحديث_عدو] = متجه2(1, 0)
                اذا رقم_عشوائي >= 1.0 و رقم_عشوائي < 2.0:
                    اتجاهات_الأعداء[مؤشر_تحديث_عدو] = متجه2(-1, 0)
                اذا رقم_عشوائي >= 2.0 و رقم_عشوائي < 3.0:
                    اتجاهات_الأعداء[مؤشر_تحديث_عدو] = متجه2(0, 1)
                اذا رقم_عشوائي >= 3.0:
                    اتجاهات_الأعداء[مؤشر_تحديث_عدو] = متجه2(0, -1)
            غير_ذلك:
                عدو.الموقع.x += اتجاه.x * سرعة_العدو
                عدو.الموقع.y += اتجاه.y * سرعة_العدو
            
            # التحقق من ملامسة اللاعب
            فرق_اللاعب_والعدو_س = اللاعب.الموقع.x - عدو.الموقع.x
            اذا فرق_اللاعب_والعدو_س < 0:
                فرق_اللاعب_والعدو_س = 0 - فرق_اللاعب_والعدو_س
            اذا فرق_اللاعب_والعدو_س < 31:
                فرق_اللاعب_والعدو_ص = اللاعب.الموقع.y - عدو.الموقع.y
                اذا فرق_اللاعب_والعدو_ص < 0:
                    فرق_اللاعب_والعدو_ص = 0 - فرق_اللاعب_والعدو_ص
                اذا فرق_اللاعب_والعدو_ص < 31:
                    هل_اللاعب_حي = مقفل
                    نص_الخسارة.النص = "لقد خسرت! اضغط مسافة للإعادة"
            
            مؤشر_تحديث_عدو += 1
    غير_ذلك:
        اذا كيبورد.مسافة == مفعل:
            اللاعب.الموقع = متجه2(75, 75)
            اتجاه_اللاعب = متجه2(0, 0)
            اللاعب.الدوران = متجه3(0, 0, 0)
            هل_اللاعب_حي = مفعل
            نص_الخسارة.النص = ""
            
            مؤشر_تحديث_عدو = 0
            كرر:
                اذا مؤشر_تحديث_عدو >= عدد_الأعداء:
                    توقف
                الأعداء[مؤشر_تحديث_عدو].الموقع = متجه2(475, 325)
                مؤشر_تحديث_عدو += 1
