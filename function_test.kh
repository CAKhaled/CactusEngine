ابغا متغير_عام = 100

دالة اجمع(ا, ب):
    نتيجة = ا + ب
    ارجع نتيجة

دالة تحية(الاسم):
    اطبع الاسم

مجموع = اجمع(10, 20)
اطبع مجموع

تحية("خالد")

دالة تجربة_المتغيرات(متغير_عام):
    متغير_عام = متغير_عام + 50
    اطبع متغير_عام

اطبع "المتغير العام قبل الدالة:"
اطبع متغير_عام

تجربة_المتغيرات(10)

اطبع "المتغير العام بعد الدالة:"
اطبع متغير_عام
