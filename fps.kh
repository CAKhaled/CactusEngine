# لعبة FPS بسيطة - كاميرا تتحرك وتلف مع حساسية
نافذة("لعبة FPS - خالد", 1280, 720)

# إعدادات الحساسية والسرعة
حساسية_الماوس = 0.2        # تم استخدام حركة_أفقية بدون وقت.دلتا لعمل أسلس
سرعة_التحرك = 12.0
ارتفاع_الكاميرا = 1.7

# إعداد السماء والأرض
صنع_سماء(لون(0.4, 0.6, 0.9))

الأرض = صنع_سطح()
الأرض.الموقع = متجه3(0, 0, 0)
الأرض.المقياس = متجه3(50, 1, 50)
الأرض.اللون = لون(0.3, 0.55, 0.25)

# إضاءة
الضوء = صنع_ضوء()
الضوء.النوع = "ضوء_موجه"
الضوء.الموقع = متجه3(10, 20, 10)
الضوء.اللون = لون(1.0, 0.95, 0.9)
الضوء.الشدة = 1.2

# مكعبات كعوائق
مكعب1 = صنع_مكعب()
مكعب1.الموقع = متجه3(5, 1, -8)
مكعب1.المقياس = متجه3(2, 2, 2)
مكعب1.اللون = لون(0.85, 0.25, 0.2)

مكعب2 = صنع_مكعب()
مكعب2.الموقع = متجه3(-6, 1.5, -12)
مكعب2.المقياس = متجه3(3, 3, 3)
مكعب2.اللون = لون(0.2, 0.4, 0.9)

مكعب3 = صنع_مكعب()
مكعب3.الموقع = متجه3(0, 1, -20)
مكعب3.المقياس = متجه3(4, 2, 2)
مكعب3.اللون = لون(0.9, 0.7, 0.1)

عمود = صنع_اسطوانة()
عمود.الموقع = متجه3(8, 2, -15)
عمود.المقياس = متجه3(1, 4, 1)
عمود.اللون = لون(0.5, 0.5, 0.55)

# وضع الكاميرا الابتدائي
الكاميرا.الموقع = متجه3(0, ارتفاع_الكاميرا, 5)
الكاميرا.الدوران = متجه3(0, 0, 0)

# إخفاء الماوس وقفله في منتصف الشاشة (حتى لا يخرج من النافذة)
ماوس.معلق = مفعل

# متغيرات الدوران
زاوية_أفقية = 0.0
زاوية_عمودية = 0.0

كل_فريم:
    # --- حركة الماوس (الالتفات) ---
    # نستخدم (حركة_أفقية) و (حركة_عمودية) لأنها تعطي مقدار حركة الماوس بين كل فريم
    # ولا نضربها في وقت.دلتا() لأن حركة الماوس لا تتأثر بسرعة الفريمات بشكل مباشر
    زاوية_أفقية -= ماوس.حركة_أفقية * حساسية_الماوس
    زاوية_عمودية -= ماوس.حركة_عمودية * حساسية_الماوس

    # منع قلب الرأس أكثر من اللازم
    اذا زاوية_عمودية > 80:
        زاوية_عمودية = 80
    اذا زاوية_عمودية < -80:
        زاوية_عمودية = -80

    الكاميرا.الدوران = متجه3(زاوية_عمودية, زاوية_أفقية, 0)

    # --- حركة WASD ---
    اتجاه = متجه3(0, 0, 0)

    اذا كيبورد.w == مفعل:
        اتجاه += الكاميرا.الأمام
    اذا كيبورد.s == مفعل:
        اتجاه -= الكاميرا.الأمام
    اذا كيبورد.d == مفعل:
        اتجاه += الكاميرا.اليمين
    اذا كيبورد.a == مفعل:
        اتجاه -= الكاميرا.اليمين

    # منع الطيران (حركة أفقية فقط)
    اتجاه.y = 0

    # تطبيق الحركة فقط إذا في ضغط على زر
    اذا اتجاه.x != 0 او اتجاه.z != 0:
        الكاميرا.الموقع += اتجاه * سرعة_التحرك * وقت.دلتا()

    # تثبيت الارتفاع دائماً
    الكاميرا.الموقع.y = ارتفاع_الكاميرا
