# المتغيرات (ضعها قبل حلقة التحديث)
سرعة_الكاميرا = 15.0
حساسية_الفأرة = 0.2
زاوية_افقية = 0.0
زاوية_رأسية = 0.0
الكاميرا.اخفاء_المؤشر = صح

تحديث:
    # 1. حركة الفأرة (الالتفاف)
    زاوية_افقية -= الفأرة.الازاحة_س * حساسية_الفأرة
    زاوية_رأسية -= الفأرة.الازاحة_ص * حساسية_الفأرة

    # منع انقلاب الكاميرا
    اذا زاوية_رأسية > 89:
        زاوية_رأسية = 89
    اذا زاوية_رأسية < -89:
        زاوية_رأسية = -89

    الكاميرا.الدوران = م3(زاوية_رأسية, زاوية_افقية, 0)

    # 2. حركة الكاميرا الحرة في جميع الاتجاهات (بناءً على زاوية النظر)
    اتجاه = م3(0, 0, 0)

    اذا لوحة_المفاتيح.w == صح:
        اتجاه += الكاميرا.الامام
    اذا لوحة_المفاتيح.s == صح:
        اتجاه -= الكاميرا.الامام
    اذا لوحة_المفاتيح.d == صح:
        اتجاه += الكاميرا.اليمين
    اذا لوحة_المفاتيح.a == صح:
        اتجاه -= الكاميرا.اليمين
    
    # الصعود والنزول العمودي المباشر
    اذا لوحة_المفاتيح.مسافة == صح:
        اتجاه += م3(0, 1, 0)
    اذا لوحة_المفاتيح.شفت == صح:
        اتجاه -= م3(0, 1, 0)

    الكاميرا.الموقع += اتجاه * سرعة_الكاميرا * الوقت.التغير()
